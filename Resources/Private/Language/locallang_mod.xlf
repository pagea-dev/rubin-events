            <trans-unit id="module.pagetree.failed"><source>The page structure could not be imported: %s</source></trans-unit>
            <trans-unit id="module.pagetree.contentFailed"><source>The page structure was created (page %d), but importing the example content into it failed: %s</source></trans-unit>

            <trans-unit id="module.config.intro"><source>Extension configuration under Admin Tools &gt; Extensions &gt; Rubin Events:</source></trans-unit>
            <trans-unit id="module.config.notSet"><source>not set</source></trans-unit>
            <trans-unit id="module.config.state.0"><source>All settings are in order</source></trans-unit>
            <trans-unit id="module.config.state.1"><source>Some settings need attention</source></trans-unit>
            <trans-unit id="module.config.state.2"><source>No setting is usable</source></trans-unit>
