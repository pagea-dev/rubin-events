            <trans-unit id="module.config.hint.defaultLat"><source>Latitude between -90 and 90, e.g. 51.5.</source></trans-unit>
            <trans-unit id="module.config.hint.defaultLon"><source>Longitude between -180 and 180, e.g. 9.5.</source></trans-unit>
            <trans-unit id="module.config.hint.defaultColPos"><source>Whole number, 0 or greater. The column the page structure importer places its plugins in.</source></trans-unit>

